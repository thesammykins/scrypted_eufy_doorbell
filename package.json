{
  "name": "@thesammykins/scrypted-eufy-doorbell",
  "version": "0.1.0",
  "description": "Eufy battery doorbells in Scrypted: on-demand P2P live view, ring and detection events, two-way audio and ring clips copied off the HomeBase.",
  "license": "MIT",
  "keywords": [
    "scrypted",
    "plugin",
    "eufy",
    "doorbell"
  ],
  "scripts": {
    "build": "node scripts/build-worker.mjs && scrypted-webpack",
    "typecheck": "node scripts/build-worker.mjs && tsc --noEmit && tsc -p worker/tsconfig.json",
    "deploy": "npm run build && scrypted-deploy ${SCRYPTED_HOST:?set SCRYPTED_HOST to your Scrypted server}",
    "console": "scripts/console.sh"
  },
  "scrypted": {
    "name": "Eufy Doorbell",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "Settings",
      "HttpRequestHandler"
    ],
    "pluginDependencies": [
      "@scrypted/prebuffer-mixin",
      "@scrypted/snapshot"
    ],
    "rollup": true
  },
  "devDependencies": {
    "@mega-yfue/eufy-sdk": "0.5.0",
    "@scrypted/sdk": "^0.5.61",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "eufyWorker": {
    "dependencies": {
      "@mega-yfue/eufy-sdk": "0.5.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thesammykins/scrypted_eufy_doorbell.git"
  }
}
