{
  "name": "@thesammykins/scrypted-eufy-doorbell",
  "version": "0.1.0",
  "description": "On-demand Eufy doorbell and camera streams, ring events and two-way audio for Scrypted.",
  "license": "MIT",
  "keywords": [
    "scrypted",
    "plugin",
    "eufy",
    "doorbell"
  ],
  "scripts": {
    "build": "node scripts/build-worker.mjs && scrypted-webpack",
    "typecheck": "node scripts/build-worker.mjs && tsc --noEmit && tsc -p worker/tsconfig.json",
    "deploy": "npm run build && scrypted-deploy 192.168.88.220",
    "console": "scripts/console.sh"
  },
  "scrypted": {
    "name": "Eufy Doorbell",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "Settings"
    ],
    "pluginDependencies": [
      "@scrypted/prebuffer-mixin",
      "@scrypted/snapshot"
    ],
    "rollup": true
  },
  "devDependencies": {
    "@mega-yfue/eufy-sdk": "0.5.0",
    "@scrypted/sdk": "^0.5.61",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "eufyWorker": {
    "dependencies": {
      "@mega-yfue/eufy-sdk": "0.5.0"
    }
  }
}
